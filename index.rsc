1:["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"shell catalog-hero","children":[["$","div",null,{"className":"catalog-hero-copy","children":[["$","h1",null,{"children":"插件与能力目录"}],["$","p",null,{"children":"检索 SciForge 生态的插件、内置模块与开发资源，查看各组件的能力边界与适配进度。"}]]}],["$","div",null,{"className":"catalog-hero-art","aria-hidden":"true","children":[["$","span",null,{}],["$","span",null,{}],["$","span",null,{}],["$","span",null,{}]]}]]}],["$","section",null,{"className":"market-body","children":["$","div",null,{"className":"shell","children":["$","$L8",null,{"items":[{"id":"@sciforge/plugin-anchored-comments","slug":"anchored-comments","kind":"plugin","title":"Anchored Comments","summary":"在文件或界面的指定位置加批注，让合作者看得出每条意见指向哪里。","categories":["collaboration","review"],"features":["在指定位置加批注","保留批注对应的修订","保存评论记录"],"scenarios":["标记文档中需要修改的一段","指出界面上需要调整的位置"],"status":"documented","statusLabel":"公开说明","statusDetail":"独立插件源码已公开。","related":[]},{"id":"@sciforge/plugin-change-inspector","slug":"change-inspector","kind":"plugin","title":"变更检查器","summary":"查看 Agent 在一次会话中改过哪些文件，并逐个核对改动。","categories":["workspace","inspection"],"features":["打开会话的变更记录","查看每个文件的差异","以只读方式审阅工作区"],"scenarios":["检查 Agent 是否改到了计划之外的文件","合并前复核改动"],"status":"adapting","statusLabel":"适配中","statusDetail":"已在隔离环境中验证插件激活，并通过桌面客户端的开发模式检查会话文件改动。","related":[]},{"id":"@sciforge/plugin-scientific-plotting","slug":"scientific-plotting","kind":"plugin","title":"Scientific Plotting","summary":"把实验数据映射到图表，保留绘图参数，方便重跑和比较结果。","categories":["science","plotting"],"features":["检查绘图环境","指定数据列与图表的对应关系","生成科研图","用原参数重跑并比对"],"scenarios":["为论文生成可重跑的图","比较两次绘图的输入和结果"],"status":"verified","statusLabel":"测试构建已验证","statusDetail":"已在 SciForge Acceptance 测试构建中验证环境检查、数据映射、出图、重跑和比对，也检查了版本记录及插件生命周期。","related":[]},{"id":"@sciforge/plugin-text-stats","slug":"text-stats","kind":"plugin","title":"文本统计","summary":"统计字数、行数和字节数，投稿前可按中文或拉丁文字的规则核对。","categories":["text","utility"],"features":["统计字符、词、行、段落和字节","区分中文和拉丁文字的计数规则","在本地完成计算"],"scenarios":["核对稿件字数是否符合要求","估算长篇审稿意见的篇幅"],"status":"documented","statusLabel":"公开说明","statusDetail":"已公开计数项目和中英文统计规则。","related":[]},{"id":"@sciforge/plugin-unit-conversion","slug":"unit-conversion","kind":"plugin","title":"科学单位换算","summary":"在同一物理量的单位之间换算，比如把摄氏度换成开尔文。","categories":["science","utility"],"features":["换算长度、质量、时间、体积、能量和压力","换算需要加减偏移量的温标","识别未知单位和不同量纲"],"scenarios":["把实验记录换算成论文采用的单位","比较使用不同单位的文献数据"],"status":"documented","statusLabel":"公开说明","statusDetail":"已公开支持的物理量与换算规则。","related":[]},{"id":"@sciforge/domain-artifact-versions","slug":"domain-artifact-versions","kind":"builtin","title":"Artifact Versions","summary":"给科研产物分配固定 ID，保留只读的历史版本，并将快照导出到其他工作区。","categories":["research","artifacts"],"features":["保存不可改写的产物版本","查看产物和版本清单","导入或导出快照"],"scenarios":["留存分析时使用的文件版本","引用同事可以复核的实验结果"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-browser-preview","slug":"domain-browser-preview","kind":"builtin","title":"Browser Preview","summary":"在工作区里打开网页，一边看资料，一边保留手头的项目。","categories":["browser","preview"],"features":["在预览面板打开网页","管理打开的页面","使用面板提供的浏览器操作"],"scenarios":["边读网页文档边做项目笔记","把在线资料与工作区内容对照"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-collaboration","slug":"domain-collaboration","kind":"builtin","title":"Collaboration","summary":"把研究任务交给同事或 Agent，在不同设备上继续看消息和进度。","categories":["collaboration"],"features":["连接协作设备","同步会话信息","保存任务和消息"],"scenarios":["把研究任务交给 Agent","在另一台设备查看同一项任务"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-computer-use","slug":"domain-computer-use","kind":"builtin","title":"Computer Use","summary":"让 Agent 在指定页面操作，并留下操作结果供复查。","categories":["automation","computer-use"],"features":["通过 MCP 连接操作环境","将浏览器操作限制在指定页面","记录操作结果"],"scenarios":["在获准的页面执行重复操作","复核 Agent 在界面中做过的事"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-create-loop","slug":"domain-create-loop","kind":"builtin","title":"Create Loop","summary":"把重复的步骤串成可复用流程，在需要确认的地方停下来审批。","categories":["automation","workflow"],"features":["用节点组织步骤","运行流程并处理审批","保存流程模板"],"scenarios":["让多次分析按同样的步骤执行","在流程中安排人工审核"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-evidence-dag","slug":"domain-evidence-dag","kind":"builtin","title":"Evidence DAG","summary":"把研究结论和支持它的材料连起来，复核时可以顺着记录找到依据。","categories":["research","evidence"],"features":["逐步补充证据","保存完整证据链的快照","读取记录供复核"],"scenarios":["追查一项结论引用了哪些材料","保留评审时看到的证据版本"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-git-checkpoints","slug":"domain-git-checkpoints","kind":"builtin","title":"Git Checkpoints","summary":"为代码实验留下 Git 检查点，需要时回到当时的工作状态。","categories":["git","checkpoints"],"features":["创建和管理 Git 检查点","按会话轮次决定何时保存","从已有检查点恢复"],"scenarios":["在试改代码前保存项目状态","回到一次已知可用的修改"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-identity-access","slug":"domain-identity-access","kind":"builtin","title":"Identity and Access","summary":"在同一台电脑上切换本地账户，分清研究记录归谁。","categories":["identity","local"],"features":["选择本地账户","为记录标注归属","按账户划分本地数据"],"scenarios":["多人共用一台电脑时区分记录","核对某条研究记录归属哪个账户"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-project-dag","slug":"domain-project-dag","kind":"builtin","title":"Project DAG","summary":"把项目目标和相互依赖的步骤画在一张图上，方便追踪研究进度。","categories":["research","project"],"features":["把项目计划整理成图","保存研究目标","查看项目状态"],"scenarios":["规划相互依赖的实验步骤","追踪一个目标关联的证据"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-research-checkpoints","slug":"domain-research-checkpoints","kind":"builtin","title":"Research Checkpoints","summary":"把已完成的一轮研究对话存成只读检查点，之后可以查阅或恢复。","categories":["research","checkpoints"],"features":["按对话轮次保存检查点","查看检查点清单和状态","导入或恢复检查点"],"scenarios":["留存形成研究判断时的对话","恢复某一次研究的记录"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-research-dossier","slug":"domain-research-dossier","kind":"builtin","title":"Research","summary":"把选定的产物版本和计算记录放进同一份研究档案，方便合作者复核。","categories":["research","presentation"],"features":["查看研究档案","引用指定产物版本或计算运行","以只读方式汇总记录"],"scenarios":["整理一项研究的结果和依据","向合作者展示可复核的计算结果"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-terminal","slug":"domain-terminal","kind":"builtin","title":"Terminal","summary":"在工作区打开终端，用标签分开不同命令会话。","categories":["workspace","terminal"],"features":["在底部面板打开终端","切换终端标签","查看命令输出"],"scenarios":["在项目目录运行命令","检查构建或分析日志"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-biology-workbench","slug":"domain-biology-workbench","kind":"builtin","title":"Biology Workbench","summary":"按项目整理生物分析，在工作区直接预览相关文件和分析历史。","categories":["life-science","workspace"],"features":["查看分析房间和历史","预览生命科学文件","保存工作区状态"],"scenarios":["回顾某个项目的分析过程","浏览分析生成的文件"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-knowledge-net","slug":"domain-knowledge-net","kind":"builtin","title":"Knowledge Net","summary":"把文献笔记和相关数据连起来，之后可以按笔记找回原始资料。","categories":["research","workspace"],"features":["整理文献笔记","关联笔记和数据","检索并导出记录"],"scenarios":["整理综述材料","追查一条笔记引用的数据"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-siyuan-content-space-provider","slug":"domain-siyuan-content-space-provider","kind":"builtin","title":"云笔记","summary":"在桌面工作区打开云笔记，用思源编辑器更新共享记录。","categories":["collaboration","workspace"],"features":["浏览云笔记","在工作区内使用思源编辑器"],"scenarios":["整理项目共享笔记","补写团队协作记录"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"@sciforge/domain-user-decisions","slug":"domain-user-decisions","kind":"builtin","title":"用户决策","summary":"Agent 需要你做决定时，会把问题和选项放在工作区里。","categories":["interaction","workflow"],"features":["显示待回答的问题和选项","在可移动的问卷中提交选择"],"scenarios":["为 Agent 选定下一步方案","边看项目资料边回答问题"],"status":"integrated","statusLabel":"已集成","statusDetail":"已并入桌面客户端源码。","related":[]},{"id":"skill:openspec-apply-change","slug":"skill-openspec-apply-change","kind":"skill","title":"OpenSpec 实现变更","summary":"按 OpenSpec 的任务清单落实已定义的变更，并记录做到了哪一步。","categories":["development"],"features":["读取现有规格","按任务落实变更","记录完成情况"],"scenarios":["开始实现已批准的变更","接着处理上次未做完的任务"],"status":"development","statusLabel":"开发资源","statusDetail":"用于开发期间的 OpenSpec 工作。","related":[]},{"id":"skill:openspec-archive-change","slug":"skill-openspec-archive-change","kind":"skill","title":"OpenSpec 归档变更","summary":"把完成的 OpenSpec 变更移入归档，保留规格和实施记录。","categories":["development"],"features":["归档已完成的变更","整理变更对应的记录"],"scenarios":["交付后归档变更","整理已经结束的开发事项"],"status":"development","statusLabel":"开发资源","statusDetail":"用于开发期间的 OpenSpec 工作。","related":[]},{"id":"skill:openspec-explore","slug":"skill-openspec-explore","kind":"skill","title":"OpenSpec 探索","summary":"在写方案前，把问题、需求和可选做法弄清楚。","categories":["development"],"features":["梳理问题","澄清需求","比较可选方案"],"scenarios":["动手前明确要解决什么","评估几种实现方式"],"status":"development","statusLabel":"开发资源","statusDetail":"用于开发期间的 OpenSpec 工作。","related":[]},{"id":"skill:openspec-propose","slug":"skill-openspec-propose","kind":"skill","title":"OpenSpec 提案","summary":"把一个想法写成变更提案，说明设计、规格和要做的任务。","categories":["development"],"features":["起草变更提案","写明设计与规格","把实施拆成具体任务"],"scenarios":["把研究想法变成可以执行的方案","在开发前把变更讲清楚"],"status":"development","statusLabel":"开发资源","statusDetail":"用于开发期间的 OpenSpec 工作。","related":[]},{"id":"sciforge.template.plugin","slug":"plugin-template","kind":"template","title":"插件模板","summary":"从现成的清单、入口和构建配置开始写 SciForge 插件。","categories":["development"],"features":["查看插件清单示例","沿用最小插件入口","用预置