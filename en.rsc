1:["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"shell catalog-hero","children":[["$","div",null,{"className":"catalog-hero-copy","children":[["$","h1",null,{"children":"Plugins and capabilities"}],["$","p",null,{"children":"Explore SciForge plugins, built-in modules and developer resources. See what each one does and where it stands."}]]}],["$","div",null,{"className":"catalog-hero-art","aria-hidden":"true","children":[["$","span",null,{}],["$","span",null,{}],["$","span",null,{}],["$","span",null,{}]]}]]}],["$","section",null,{"className":"market-body","children":["$","div",null,{"className":"shell","children":["$","$L8",null,{"items":[{"id":"@sciforge/plugin-anchored-comments","slug":"anchored-comments","kind":"plugin","title":"Anchored Comments","summary":"Leave comments on specific parts of a file or interface so reviewers know exactly what each note refers to.","categories":["collaboration","review"],"features":["Pin comments to a location","Keep the revision a comment refers to","Save the comment history"],"scenarios":["Flag a paragraph for revision","Point out where an interface needs a change"],"status":"documented","statusLabel":"Documented","statusDetail":"The standalone plugin source is public.","related":[]},{"id":"@sciforge/plugin-change-inspector","slug":"change-inspector","kind":"plugin","title":"Change Inspector","summary":"See which files an agent changed during a session and review each diff.","categories":["workspace","inspection"],"features":["Open a session's change record","Inspect individual file diffs","Review the workspace in read-only mode"],"scenarios":["Check whether an agent touched unexpected files","Review changes before merging"],"status":"adapting","statusLabel":"Integration in progress","statusDetail":"Activation was tested in an isolated environment, and session file changes were reviewed in the desktop client's development mode.","related":[]},{"id":"@sciforge/plugin-scientific-plotting","slug":"scientific-plotting","kind":"plugin","title":"Scientific Plotting","summary":"Map experimental data to a chart and keep the plotting settings so you can rerun it and compare the results.","categories":["science","plotting"],"features":["Check the plotting environment","Map data columns to a chart","Generate a figure","Rerun with the saved settings and compare results"],"scenarios":["Create a reproducible figure for a paper","Compare the inputs and outputs of two runs"],"status":"verified","statusLabel":"Verified in test build","statusDetail":"The SciForge Acceptance test build verified environment checks, data mapping, rendering, reruns and comparison, as well as version history and the plugin lifecycle.","related":[]},{"id":"@sciforge/plugin-text-stats","slug":"text-stats","kind":"plugin","title":"Text Statistics","summary":"Count words, characters and bytes, with separate rules for Chinese and Latin-script text.","categories":["text","utility"],"features":["Count characters, words, lines, paragraphs and bytes","Use separate counting rules for Chinese and Latin scripts","Run the calculation locally"],"scenarios":["Check a manuscript's word limit","Measure the length of a set of review comments"],"status":"documented","statusLabel":"Documented","statusDetail":"The counting options and the rules for Chinese and English text are documented.","related":[]},{"id":"@sciforge/plugin-unit-conversion","slug":"unit-conversion","kind":"plugin","title":"Scientific Unit Conversion","summary":"Convert between units of the same quantity, such as Celsius and Kelvin.","categories":["science","utility"],"features":["Convert length, mass, time, volume, energy and pressure","Handle temperature scales with an offset","Flag unknown units and incompatible dimensions"],"scenarios":["Express lab records in the units used in a paper","Compare values reported in different units"],"status":"documented","statusLabel":"Documented","statusDetail":"The supported quantities and conversion rules are documented.","related":[]},{"id":"@sciforge/domain-artifact-versions","slug":"domain-artifact-versions","kind":"builtin","title":"Artifact Versions","summary":"Give research outputs a stable ID, keep read-only versions, and export snapshots to another workspace.","categories":["research","artifacts"],"features":["Save immutable versions","List outputs and open specific versions","Import and export snapshots"],"scenarios":["Keep the exact files used in an analysis","Cite an experimental result someone else can verify"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-browser-preview","slug":"domain-browser-preview","kind":"builtin","title":"Browser Preview","summary":"Open a web page beside your project so you can refer to it while you work.","categories":["browser","preview"],"features":["Open pages in the preview panel","Manage open pages","Use the panel's browsing controls"],"scenarios":["Read online documentation while taking notes","Compare an online reference with workspace material"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-collaboration","slug":"domain-collaboration","kind":"builtin","title":"Collaboration","summary":"Hand research tasks to teammates or agents and follow messages and progress across devices.","categories":["collaboration"],"features":["Connect collaboration devices","Sync session information","Keep tasks and messages"],"scenarios":["Assign a research task to an agent","Check the same task on another device"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-computer-use","slug":"domain-computer-use","kind":"builtin","title":"Computer Use","summary":"Let an agent operate a designated page and keep a record of what it did.","categories":["automation","computer-use"],"features":["Connect to the operating environment through MCP","Limit browser actions to designated pages","Record action results"],"scenarios":["Repeat steps on an approved page","Review an agent's actions in the interface"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-create-loop","slug":"domain-create-loop","kind":"builtin","title":"Create Loop","summary":"Turn repeated steps into a reusable workflow with pauses for approval where needed.","categories":["automation","workflow"],"features":["Arrange steps as workflow nodes","Run a workflow and handle approvals","Save workflow templates"],"scenarios":["Repeat an analysis with the same steps","Put a human review into a workflow"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-evidence-dag","slug":"domain-evidence-dag","kind":"builtin","title":"Evidence DAG","summary":"Connect a research conclusion to its supporting material so reviewers can follow the evidence.","categories":["research","evidence"],"features":["Add evidence as it becomes available","Save a snapshot of the evidence chain","Read the record for review"],"scenarios":["Trace which materials support a conclusion","Keep the version of the evidence used in a review"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-git-checkpoints","slug":"domain-git-checkpoints","kind":"builtin","title":"Git Checkpoints","summary":"Save Git checkpoints during a code experiment so you can return to an earlier workspace state.","categories":["git","checkpoints"],"features":["Create and manage Git checkpoints","Choose when to save by session turn","Restore an existing checkpoint"],"scenarios":["Save the project before trying a change","Return to a known working state"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-identity-access","slug":"domain-identity-access","kind":"builtin","title":"Identity and Access","summary":"Switch local accounts on a shared computer and keep research records attributed to the right person.","categories":["identity","local"],"features":["Choose a local account","Label record ownership","Separate local data by account"],"scenarios":["Keep records separate on a shared computer","Check which account owns a research record"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-project-dag","slug":"domain-project-dag","kind":"builtin","title":"Project DAG","summary":"Map goals and dependent steps so you can follow a research project's progress.","categories":["research","project"],"features":["Compile a project plan into a graph","Save research goals","Check project status"],"scenarios":["Plan experiments with dependent steps","Trace the evidence linked to a goal"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-research-checkpoints","slug":"domain-research-checkpoints","kind":"builtin","title":"Research Checkpoints","summary":"Save a completed research turn as a read-only checkpoint for later review or restoration.","categories":["research","checkpoints"],"features":["Save checkpoints by conversation turn","List checkpoints and check their status","Import or restore a checkpoint"],"scenarios":["Keep the conversation behind a research decision","Recover the record of an earlier investigation"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-research-dossier","slug":"domain-research-dossier","kind":"builtin","title":"Research","summary":"Bring selected output versions and computation records into one dossier for collaborators to review.","categories":["research","presentation"],"features":["View a research dossier","Reference output versions or computation runs","Assemble a read-only record"],"scenarios":["Organize the results and sources of a study","Share computation results someone else can verify"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-terminal","slug":"domain-terminal","kind":"builtin","title":"Terminal","summary":"Open a terminal inside the workspace and use tabs to keep sessions separate.","categories":["workspace","terminal"],"features":["Open the bottom terminal panel","Switch between terminal tabs","Read command output"],"scenarios":["Run a command from the project directory","Check build or analysis logs"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-biology-workbench","slug":"domain-biology-workbench","kind":"builtin","title":"Biology Workbench","summary":"Organize biological analyses by project and preview related files and analysis history in the workspace.","categories":["life-science","workspace"],"features":["Open analysis rooms and review history","Preview life science files","Save workspace state"],"scenarios":["Review the analyses carried out for a project","Inspect files produced by an analysis"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-knowledge-net","slug":"domain-knowledge-net","kind":"builtin","title":"Knowledge Net","summary":"Link literature notes to their data so you can find the underlying material later.","categories":["research","workspace"],"features":["Organize literature notes","Link notes to data","Find and export records"],"scenarios":["Collect material for a literature review","Trace a note back to its data"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-siyuan-content-space-provider","slug":"domain-siyuan-content-space-provider","kind":"builtin","title":"Cloud Notes","summary":"Open cloud notes in the desktop workspace and update shared records with the SiYuan editor.","categories":["collaboration","workspace"],"features":["Browse cloud notes","Use the SiYuan editor in the workspace"],"scenarios":["Organize shared project notes","Add to a team's working notes"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"@sciforge/domain-user-decisions","slug":"domain-user-decisions","kind":"builtin","title":"User Decisions","summary":"Answer an agent's questions and choose what it should do next from within the workspace.","categories":["interaction","workflow"],"features":["Show questions and available choices","Submit choices in a movable questionnaire"],"scenarios":["Choose the agent's next step","Refer to project material while answering"],"status":"integrated","statusLabel":"Integrated","statusDetail":"Part of the desktop client source.","related":[]},{"id":"skill:openspec-apply-change","slug":"skill-openspec-apply-change","kind":"skill","title":"OpenSpec Apply Change","summary":"Implement a defined OpenSpec change from its task list and record what is complete.","categories":["development"],"features":["Read the existing spec","Work through the change tasks","Record progress"],"scenarios":["Start an approved change","Pick up unfinished work"],"status":"development","statusLabel":"Development resource","statusDetail":"For OpenSpec tasks during development.","related":[]},{"id":"skill:openspec-archive-change","slug":"skill-openspec-archive-change","kind":"skill","title":"OpenSpec Archive Change","summary":"Archive a completed OpenSpec change and keep its specification and implementation record.","categories":["development"],"features":["Archive completed changes","Keep records with the change"],"scenarios":["Archive a change after delivery","Tidy up finished development work"],"status":"development","statusLabel":"Development resource","statusDetail":"For OpenSpec tasks during development.","related":[]},{"id":"skill:openspec-explore","slug":"skill-openspec-explore","kind":"skill","title":"OpenSpec Explore","summary":"Clarify the problem, requirements and possible approaches before writing a proposal.","categories":["development"],"features":["Identify the problem","Clarify requirements","Compare approaches"],"scenarios":["Define the problem before starting work","Evaluate several implementation options"],"status":"development","statusLabel":"Development resource","statusDetail":"For OpenSpec tasks during development.","related":[]},{"id":"skill:openspec-propose","slug":"skill-openspec-propose","kind":"skill","title":"OpenSpec Propose","summary":"Turn an idea into a change proposal with a design, specification and task list.","categories":["development"],"features":["Draft a proposal","Write the design and spec","Break implementation into tasks"],"scenarios":["Turn a research idea into an actionable plan","Explain a change before development starts"],"status":"development","statusLabel":"Development resource","statusDetail":"For OpenSpec tasks during development.","related":[]},{"id":"sciforge.template.plugin","slug":"plugin-template","kind":"template","title":"Plugin Template","summary":"Start a SciForge plugin with a sample manifest, entry point and build setup.","categories":["development"],"features":["Read the sample manifest","Reuse the minimal entry point","Build with the supplied configuration"],"scenarios":["Create a new plugin","Learn the minimum plugin file structure"],"status":"development","statusLabel":"Development resource","statusDetail":"A starting project for developing a plugin.","related":[]},{"id":"fixtures:test-fixtures","slug":"fixtures-test-fixtures","kind":"fixture","title":"Test Fixtures (47 Files)","summary":"Use 47 test files to reproduce parsing and processing cases.","categories":["testing"],"features":["Supply synthetic input","Recreate specific test cases"],"scenarios":["Check how a parser handles sample input","Reproduce a processing failure"],"status":"testing","statusLabel":"Test resource","statusDetail":"Used by automated tests.","related":[]},{"id":"fixtures:scripts/fixtures","slug":"fixtures-scripts-fixtures","kind":"fixture","title":"Script Test Fixtures","summary":"Check script output on small samples and rerun the same inputs after a change.","categories":["testing"],"features":["Supply small sample inputs","Repeat script test cases"],"scenarios":["Check the output of a script on a sample","Spot regressions after editing a script"],"status":"testing","statusLabel":"Test resource","statusDetail":"Used by automated tests.","related":[]},{"id":"fixtures:scripts/e2e/fixtures","slug":"fixtures-scripts-e2e-fixtures","kind":"fixture","title":"End-to-End Test Fixtures","summary":"Run complete flows with synthetic scenarios and check how key interactions behave.","categories":["testing"],"features":["Supply end-to-end test inputs","Recreate key interactions"],"scenarios":["Verify a multi-step flow","Check key interactions for regressions"],"status":"testing","statusLabel":"Test resource","statusDetail":"Used by automated tests.","related":[]}],"locale":"en"}]}]}]]}]
